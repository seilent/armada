#!/usr/bin/env python3
import json
import os
import subprocess
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

DEVICE_ENV = os.environ.get("ARMADA_DEVICE_ENV", "/usr/libexec/armada/device-env")
LOGIN1 = ("org.freedesktop.login1", "/org/freedesktop/login1", "org.freedesktop.login1.Manager")


def device_card():
    script = f'eval "$({DEVICE_ENV})"; printf %s "${{ARMADA_SLEEP_AUDIO_CARD:-}}"'
    return subprocess.run(["bash", "-c", script], capture_output=True, text=True).stdout.strip()


def active_profile(card):
    out = subprocess.run(
        ["pactl", "--format=json", "list", "cards"], capture_output=True, text=True, check=True
    ).stdout
    for entry in json.loads(out):
        if entry.get("name") == card:
            return entry.get("active_profile")
    return None


class AudioSleep:
    def __init__(self, bus, card):
        self.bus = bus
        self.card = card
        self.fd = None
        self.saved = None

    def inhibit(self):
        if self.fd is not None:
            return
        result, fds = self.bus.call_with_unix_fd_list_sync(
            *LOGIN1,
            "Inhibit",
            GLib.Variant(
                "(ssss)",
                ("sleep", "Armada", "Turn the internal audio card off before suspend", "delay"),
            ),
            GLib.VariantType("(h)"),
            Gio.DBusCallFlags.NONE,
            -1,
            None,
            None,
        )
        self.fd = fds.get(result.unpack()[0])

    def release(self):
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None

    def suspend_card(self):
        try:
            profile = active_profile(self.card)
            if profile and profile != "off":
                subprocess.run(["pactl", "set-card-profile", self.card, "off"], check=True)
                self.saved = profile
        except (subprocess.CalledProcessError, OSError, ValueError) as err:
            print(f"audio-sleep: turning {self.card} off failed: {err}", file=sys.stderr)

    def resume_card(self):
        if not self.saved:
            return
        result = subprocess.run(["pactl", "set-card-profile", self.card, self.saved])
        if result.returncode:
            print(f"audio-sleep: restoring {self.card} to {self.saved} failed", file=sys.stderr)
        self.saved = None

    def prepare_for_sleep(self, _conn, _sender, _path, _iface, _signal, params):
        if params.unpack()[0]:
            self.suspend_card()
            self.release()
        else:
            self.resume_card()
            self.inhibit()


def main():
    card = device_card()
    if not card:
        return
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    sleeper = AudioSleep(bus, card)
    bus.signal_subscribe(
        LOGIN1[0], LOGIN1[2], "PrepareForSleep", LOGIN1[1], None,
        Gio.DBusSignalFlags.NONE, sleeper.prepare_for_sleep,
    )
    sleeper.inhibit()
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
