+++ b/src/drivers/ssc/driver.rs
@@ -0,0 +1,803 @@
+use std::{
+    collections::HashSet,
+    io, mem,
+    time::{Duration, Instant},
+};
+
+use crate::{
+    drivers::iio_imu::{
+        event::{AxisData, Event},
+        info::MountMatrix,
+    },
+    input::capability::{Capability, Source},
+};
+
+use super::{
+    protobuf::{self, Value},
+    qmi,
+    qrtr::{self, Server},
+};
+
+const SSC_SERVICE: u32 = 400;
+const DEFAULT_SAMPLE_RATE: f64 = 400.0;
+const STALL_TIMEOUT: Duration = Duration::from_secs(3);
+const RETRY_MIN: Duration = Duration::from_secs(3);
+const RETRY_MAX: Duration = Duration::from_secs(60);
+const RECV_BUFFER_SIZE: usize = 65536;
+
+const SUID_UID: Uid = Uid {
+    low: 0xABABABABABABABAB,
+    high: 0xABABABABABABABAB,
+};
+const MSG_ERROR_EVENT: u32 = 6;
+const MSG_DISABLE: u32 = 10;
+const MSG_SUID_REQUEST: u32 = 512;
+const MSG_ENABLE_CONTINUOUS: u32 = 513;
+const MSG_CONFIG_EVENT: u32 = 768;
+const MSG_MEASUREMENT: u32 = 1025;
+const PROCESSOR_APSS: u64 = 1;
+const DELIVERY_NO_WAKEUP: u64 = 1;
+const STATUS_UNRELIABLE: u64 = 0;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+struct Uid {
+    low: u64,
+    high: u64,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Sensor {
+    Accel,
+    Gyro,
+}
+
+impl Sensor {
+    fn data_type(&self) -> &'static str {
+        match self {
+            Sensor::Accel => "accel",
+            Sensor::Gyro => "gyro",
+        }
+    }
+
+    fn capability(&self) -> Capability {
+        match self {
+            Sensor::Accel => Capability::Accelerometer(Source::Center),
+            Sensor::Gyro => Capability::Gyroscope(Source::Center),
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Action {
+    Enable,
+    Disable,
+    Lookup,
+    None,
+}
+
+fn plan(filtered: bool, server_present: bool, uid: Option<Uid>, streaming: bool) -> Action {
+    if !server_present {
+        return Action::None;
+    }
+    match (filtered, streaming, uid) {
+        (true, true, _) => Action::Disable,
+        (false, false, Some(_)) => Action::Enable,
+        (false, false, None) => Action::Lookup,
+        _ => Action::None,
+    }
+}
+
+#[derive(Debug, Clone, Copy)]
+struct Stream {
+    uid: Uid,
+    last_sample: Instant,
+}
+
+struct Session {
+    socket: qrtr::Socket,
+    server: Option<Server>,
+    accel: Option<Stream>,
+    gyro: Option<Stream>,
+    uid_accel: Option<Uid>,
+    uid_gyro: Option<Uid>,
+    lookup: Option<Lookup>,
+    txn: u16,
+}
+
+impl Session {
+    fn open() -> io::Result<Self> {
+        let socket = qrtr::Socket::new()?;
+        socket.lookup(SSC_SERVICE)?;
+        Ok(Self {
+            socket,
+            server: None,
+            accel: None,
+            gyro: None,
+            uid_accel: None,
+            uid_gyro: None,
+            lookup: None,
+            txn: 0,
+        })
+    }
+
+    fn send(&mut self, uid: Uid, msg_id: u32, payload: Option<&[u8]>) -> io::Result<()> {
+        let Some(server) = self.server else {
+            return Ok(());
+        };
+
+        let mut uid_msg = Vec::with_capacity(18);
+        protobuf::put_fixed64(&mut uid_msg, 1, uid.low);
+        protobuf::put_fixed64(&mut uid_msg, 2, uid.high);
+        let mut config = Vec::with_capacity(4);
+        protobuf::put_uint(&mut config, 1, PROCESSOR_APSS);
+        protobuf::put_uint(&mut config, 2, DELIVERY_NO_WAKEUP);
+        let mut body = Vec::new();
+        if let Some(payload) = payload {
+            protobuf::put_bytes(&mut body, 2, payload);
+        }
+
+        let mut request = Vec::with_capacity(body.len() + 32);
+        protobuf::put_bytes(&mut request, 1, &uid_msg);
+        protobuf::put_fixed32(&mut request, 2, msg_id);
+        protobuf::put_bytes(&mut request, 3, &config);
+        protobuf::put_bytes(&mut request, 4, &body);
+
+        self.txn = self.txn.wrapping_add(1).max(1);
+        let msg = qmi::ssc_control(self.txn, &request);
+        self.socket.send_to(server.node, server.port, &msg)
+    }
+
+    fn request_suid(&mut self, sensor: Sensor) -> io::Result<()> {
+        let mut msg = Vec::new();
+        protobuf::put_bytes(&mut msg, 1, sensor.data_type().as_bytes());
+        protobuf::put_uint(&mut msg, 2, 0);
+        protobuf::put_uint(&mut msg, 3, 1);
+        self.send(SUID_UID, MSG_SUID_REQUEST, Some(&msg))
+    }
+
+    fn enable(&mut self, uid: Uid, sample_rate: f32) -> io::Result<()> {
+        let mut msg = Vec::new();
+        protobuf::put_float(&mut msg, 1, sample_rate);
+        self.send(uid, MSG_ENABLE_CONTINUOUS, Some(&msg))
+    }
+
+    fn disable(&mut self) {
+        for stream in [self.accel.take(), self.gyro.take()].into_iter().flatten() {
+            if let Err(e) = self.send(stream.uid, MSG_DISABLE, None) {
+                log::debug!("Failed to disable SSC sensor: {e}");
+            }
+        }
+    }
+
+    fn apply(&mut self, sensor: Sensor, filtered: bool, sample_rate: f32) -> io::Result<()> {
+        let uid = *self.uid_mut(sensor);
+        let streaming = self.stream_mut(sensor).is_some();
+        match (plan(filtered, self.server.is_some(), uid, streaming), uid) {
+            (Action::Enable, Some(uid)) => {
+                log::info!(
+                    "Enabling SSC {} sensor {:016x}{:016x} at {} Hz",
+                    sensor.data_type(),
+                    uid.high,
+                    uid.low,
+                    sample_rate
+                );
+                *self.stream_mut(sensor) = Some(Stream {
+                    uid,
+                    last_sample: Instant::now(),
+                });
+                self.enable(uid, sample_rate)
+            }
+            (Action::Disable, _) => {
+                let Some(stream) = self.stream_mut(sensor).take() else {
+                    return Ok(());
+                };
+                log::info!("Disabling filtered SSC {} sensor", sensor.data_type());
+                self.send(stream.uid, MSG_DISABLE, None)
+            }
+            (Action::Lookup, _) => {
+                self.lookup
+                    .get_or_insert_with(|| Lookup::new(Instant::now()));
+                self.request_suid(sensor)
+            }
+            _ => Ok(()),
+        }
+    }
+
+    fn missing(&self, filtered: &HashSet<Capability>) -> Vec<Sensor> {
+        let mut missing = Vec::new();
+        for (sensor, uid) in [
+            (Sensor::Accel, self.uid_accel),
+            (Sensor::Gyro, self.uid_gyro),
+        ] {
+            if uid.is_none() && !filtered.contains(&sensor.capability()) {
+                missing.push(sensor);
+            }
+        }
+        missing
+    }
+
+    fn retry_lookup(&mut self, now: Instant, filtered: &HashSet<Capability>) -> io::Result<()> {
+        let missing = self.missing(filtered);
+        let Some(lookup) = self.lookup.as_mut() else {
+            return Ok(());
+        };
+        if missing.is_empty() {
+            self.lookup = None;
+            return Ok(());
+        }
+        let Some(delay) = lookup.due(now) else {
+            return Ok(());
+        };
+        for sensor in missing {
+            log::debug!(
+                "Retrying SSC {} sensor lookup, next in {delay:?}",
+                sensor.data_type()
+            );
+            self.request_suid(sensor)?;
+        }
+        Ok(())
+    }
+
+    fn stream_mut(&mut self, sensor: Sensor) -> &mut Option<Stream> {
+        match sensor {
+            Sensor::Accel => &mut self.accel,
+            Sensor::Gyro => &mut self.gyro,
+        }
+    }
+
+    fn uid_mut(&mut self, sensor: Sensor) -> &mut Option<Uid> {
+        match sensor {
+            Sensor::Accel => &mut self.uid_accel,
+            Sensor::Gyro => &mut self.uid_gyro,
+        }
+    }
+
+    fn sensor_for(&self, uid: Uid) -> Option<Sensor> {
+        if self.accel.is_some_and(|stream| stream.uid == uid) {
+            return Some(Sensor::Accel);
+        }
+        if self.gyro.is_some_and(|stream| stream.uid == uid) {
+            return Some(Sensor::Gyro);
+        }
+        None
+    }
+
+    fn stalled(&self, now: Instant, filtered: &HashSet<Capability>) -> bool {
+        [(Sensor::Accel, self.accel), (Sensor::Gyro, self.gyro)]
+            .into_iter()
+            .filter(|(sensor, _)| !filtered.contains(&sensor.capability()))
+            .filter_map(|(_, stream)| stream)
+            .any(|stream| now.duration_since(stream.last_sample) > STALL_TIMEOUT)
+    }
+}
+
+impl Drop for Session {
+    fn drop(&mut self) {
+        self.disable();
+    }
+}
+
+struct Backoff {
+    delay: Duration,
+    retry_at: Instant,
+}
+
+impl Backoff {
+    fn new(now: Instant) -> Self {
+        Self {
+            delay: RETRY_MIN,
+            retry_at: now,
+        }
+    }
+
+    fn ready(&self, now: Instant) -> bool {
+        now >= self.retry_at
+    }
+
+    fn fail(&mut self, now: Instant) -> Duration {
+        let delay = self.delay;
+        self.retry_at = now + delay;
+        self.delay = (delay * 2).min(RETRY_MAX);
+        delay
+    }
+
+    fn reset(&mut self) {
+        self.delay = RETRY_MIN;
+    }
+}
+
+struct Lookup {
+    backoff: Backoff,
+    missed: Vec<Sensor>,
+}
+
+impl Lookup {
+    fn new(now: Instant) -> Self {
+        let mut backoff = Backoff::new(now);
+        backoff.fail(now);
+        Self {
+            backoff,
+            missed: Vec::new(),
+        }
+    }
+
+    fn due(&mut self, now: Instant) -> Option<Duration> {
+        if !self.backoff.ready(now) {
+            return None;
+        }
+        Some(self.backoff.fail(now))
+    }
+
+    fn first_miss(&mut self, sensor: Sensor) -> bool {
+        if self.missed.contains(&sensor) {
+            return false;
+        }
+        self.missed.push(sensor);
+        true
+    }
+}
+
+pub struct Driver {
+    sample_rate: f32,
+    mount_matrix: MountMatrix,
+    session: Option<Session>,
+    suspended: bool,
+    backoff: Backoff,
+    buffer: Vec<u8>,
+    filtered_events: HashSet<Capability>,
+}
+
+impl Driver {
+    pub fn new(mount_matrix: Option<MountMatrix>, sample_rate: Option<f64>) -> Self {
+        Self {
+            sample_rate: sample_rate.unwrap_or(DEFAULT_SAMPLE_RATE) as f32,
+            mount_matrix: mount_matrix.unwrap_or_default(),
+            session: None,
+            suspended: false,
+            backoff: Backoff::new(Instant::now()),
+            buffer: vec![0; RECV_BUFFER_SIZE],
+            filtered_events: Default::default(),
+        }
+    }
+
+    pub fn update_filtered_events(&mut self, events: HashSet<Capability>) {
+        self.filtered_events = events;
+        if let Err(e) = self.apply_filter() {
+            log::warn!("SSC session failed: {e}");
+            self.restart();
+        }
+    }
+
+    fn apply_filter(&mut self) -> io::Result<()> {
+        let Some(session) = self.session.as_mut() else {
+            return Ok(());
+        };
+        for sensor in [Sensor::Accel, Sensor::Gyro] {
+            let filtered = self.filtered_events.contains(&sensor.capability());
+            session.apply(sensor, filtered, self.sample_rate)?;
+        }
+        Ok(())
+    }
+
+    pub fn suspend(&mut self) {
+        log::info!("Disabling SSC sensors for system suspend");
+        self.suspended = true;
+        self.session = None;
+    }
+
+    pub fn resume(&mut self) {
+        log::info!("Re-enabling SSC sensors after system resume");
+        self.suspended = false;
+        self.backoff = Backoff::new(Instant::now());
+    }
+
+    pub fn poll(&mut self) -> io::Result<Vec<Event>> {
+        let mut events = vec![];
+        if self.suspended {
+            return Ok(events);
+        }
+
+        if self.session.is_none() {
+            let now = Instant::now();
+            if !self.backoff.ready(now) {
+                return Ok(events);
+            }
+            match Session::open() {
+                Ok(session) => self.session = Some(session),
+                Err(e) => {
+                    let delay = self.backoff.fail(now);
+                    log::warn!("Failed to open SSC session, retrying in {delay:?}: {e}");
+                    return Ok(events);
+                }
+            }
+        }
+
+        if let Err(e) = self.receive(&mut events) {
+            log::warn!("SSC session failed: {e}");
+            self.restart();
+            return Ok(events);
+        }
+
+        let now = Instant::now();
+        let filtered = &self.filtered_events;
+        if let Some(Err(e)) = self
+            .session
+            .as_mut()
+            .map(|session| session.retry_lookup(now, filtered))
+        {
+            log::warn!("SSC session failed: {e}");
+            self.restart();
+            return Ok(events);
+        }
+
+        if self
+            .session
+            .as_ref()
+            .is_some_and(|session| session.stalled(now, &self.filtered_events))
+        {
+            log::warn!("SSC sensor sent no samples for {STALL_TIMEOUT:?}");
+            self.restart();
+        }
+
+        Ok(events)
+    }
+
+    fn restart(&mut self) {
+        self.session = None;
+        let delay = self.backoff.fail(Instant::now());
+        log::warn!("Restarting SSC session in {delay:?}");
+    }
+
+    fn receive(&mut self, events: &mut Vec<Event>) -> io::Result<()> {
+        let mut buffer = mem::take(&mut self.buffer);
+        let result = self.drain(&mut buffer, events);
+        self.buffer = buffer;
+        result
+    }
+
+    fn drain(&mut self, buffer: &mut [u8], events: &mut Vec<Event>) -> io::Result<()> {
+        loop {
+            let Some(session) = self.session.as_ref() else {
+                return Ok(());
+            };
+            let Some((len, node, port)) = session.socket.recv_from(buffer)? else {
+                return Ok(());
+            };
+            let data = &buffer[..len];
+
+            if port == qrtr::PORT_CTRL {
+                self.handle_ctrl(data)?;
+                continue;
+            }
+
+            let Some(server) = session.server else {
+                continue;
+            };
+            if server.node != node || server.port != port {
+                continue;
+            }
+            self.handle_qmi(data, events)?;
+        }
+    }
+
+    fn handle_ctrl(&mut self, data: &[u8]) -> io::Result<()> {
+        let Some(session) = self.session.as_ref() else {
+            return Ok(());
+        };
+        let Some((cmd, server)) = qrtr::parse_ctrl(data) else {
+            return Ok(());
+        };
+        if server.service != SSC_SERVICE {
+            return Ok(());
+        }
+
+        match cmd {
+            qrtr::TYPE_NEW_SERVER if session.server.is_none() => {
+                log::info!(
+                    "Found SSC service on QRTR node {} port {}",
+                    server.node,
+                    server.port
+                );
+                if let Some(session) = self.session.as_mut() {
+                    session.server = Some(server);
+                    session.lookup = None;
+                }
+                self.apply_filter()?;
+            }
+            qrtr::TYPE_DEL_SERVER if session.server == Some(server) => {
+                log::info!("SSC service removed, waiting for it to return");
+                let Some(session) = self.session.as_mut() else {
+                    return Ok(());
+                };
+                session.server = None;
+                session.accel = None;
+                session.gyro = None;
+                session.uid_accel = None;
+                session.uid_gyro = None;
+                session.lookup = None;
+            }
+            _ => (),
+        }
+
+        Ok(())
+    }
+
+    fn handle_qmi(&mut self, data: &[u8], events: &mut Vec<Event>) -> io::Result<()> {
+        let Some(msg) = qmi::Message::parse(data) else {
+            log::debug!("Dropping malformed QMI message");
+            return Ok(());
+        };
+
+        match (msg.kind, msg.msg_id) {
+            (qmi::TYPE_RESPONSE, qmi::SSC_CONTROL) => {
+                if let Some((result, error)) = msg.result() {
+                    if result != 0 {
+                        log::warn!("SSC request failed with QMI error {error}");
+                    }
+                }
+            }
+            (qmi::TYPE_INDICATION, qmi::SSC_REPORT_SMALL | qmi::SSC_REPORT_LARGE) => {
+                if let Some(report) = msg.ssc_data() {
+                    self.handle_report(report, events)?;
+                }
+            }
+            _ => (),
+        }
+
+        Ok(())
+    }
+
+    fn handle_report(&mut self, report: &[u8], events: &mut Vec<Event>) -> io::Result<()> {
+        let uid = protobuf::fields(report).find_map(|field| match field {
+            (1, Value::Bytes(bytes)) => parse_uid(bytes),
+            _ => None,
+        });
+        let Some(uid) = uid else {
+            log::debug!("Dropping SSC report without sensor uid");
+            return Ok(());
+        };
+
+        for field in protobuf::fields(report) {
+            let (2, Value::Bytes(body)) = field else {
+                continue;
+            };
+            let mut msg_id = None;
+            let mut payload: &[u8] = &[];
+            for field in protobuf::fields(body) {
+                match field {
+                    (1, Value::Fixed32(value)) => msg_id = Some(value),
+                    (3, Value::Bytes(bytes)) => payload = bytes,
+                    _ => (),
+                }
+            }
+            let Some(msg_id) = msg_id else {
+                continue;
+            };
+
+            if msg_id == MSG_ERROR_EVENT {
+                let error = protobuf::fields(payload).find_map(|field| match field {
+                    (1, Value::Varint(error)) => Some(error),
+                    _ => None,
+                });
+                log::debug!(
+                    "SSC error event {error:?} from sensor {:016x}{:016x}",
+                    uid.high,
+                    uid.low
+                );
+                continue;
+            }
+
+            if uid == SUID_UID && msg_id == MSG_CONFIG_EVENT {
+                self.handle_suid(payload)?;
+                continue;
+            }
+
+            let Some(session) = self.session.as_mut() else {
+                return Ok(());
+            };
+            let Some(sensor) = session.sensor_for(uid) else {
+                continue;
+            };
+            match msg_id {
+                MSG_CONFIG_EVENT => {
+                    let rate = protobuf::floats(payload, 1).next();
+                    log::info!("SSC {} configured at {rate:?} Hz", sensor.data_type());
+                }
+                MSG_MEASUREMENT => {
+                    if let Some(stream) = session.stream_mut(sensor) {
+                        stream.last_sample = Instant::now();
+                    }
+                    self.backoff.reset();
+                    if let Some(event) = self.translate(sensor, payload) {
+                        events.push(event);
+                    }
+                }
+                _ => (),
+            }
+        }
+
+        Ok(())
+    }
+
+    fn handle_suid(&mut self, payload: &[u8]) -> io::Result<()> {
+        let Some(session) = self.session.as_mut() else {
+            return Ok(());
+        };
+
+        let mut data_type = None;
+        let mut uid = None;
+        for field in protobuf::fields(payload) {
+            match field {
+                (1, Value::Bytes(bytes)) => data_type = Some(bytes),
+                (2, Value::Bytes(bytes)) if uid.is_none() => uid = parse_uid(bytes),
+                _ => (),
+            }
+        }
+        let sensor = match data_type {
+            Some(b"accel") => Sensor::Accel,
+            Some(b"gyro") => Sensor::Gyro,
+            _ => return Ok(()),
+        };
+        if session.uid_mut(sensor).is_some() {
+            return Ok(());
+        }
+        let Some(uid) = uid else {
+            let first = session
+                .lookup
+                .as_mut()
+                .is_none_or(|lookup| lookup.first_miss(sensor));
+            if first {
+                log::info!(
+                    "No SSC sensor available for '{}' yet, retrying lookup",
+                    sensor.data_type()
+                );
+            } else {
+                log::debug!("No SSC sensor available for '{}'", sensor.data_type());
+            }
+            return Ok(());
+        };
+
+        *session.uid_mut(sensor) = Some(uid);
+        let filtered = self.filtered_events.contains(&sensor.capability());
+        session.apply(sensor, filtered, self.sample_rate)
+    }
+
+    fn translate(&self, sensor: Sensor, payload: &[u8]) -> Option<Event> {
+        if self.filtered_events.contains(&sensor.capability()) || is_unreliable(payload) {
+            return None;
+        }
+
+        let mut values = protobuf::floats(payload, 1).map(f64::from);
+        let (Some(x), Some(y), Some(z)) = (values.next(), values.next(), values.next()) else {
+            return None;
+        };
+        let data = self.rotate(x, y, z);
+        match sensor {
+            Sensor::Accel => Some(Event::Accelerometer(data)),
+            Sensor::Gyro => Some(Event::Gyro(data)),
+        }
+    }
+
+    fn rotate(&self, x: f64, y: f64, z: f64) -> AxisData {
+        let m = &self.mount_matrix;
+        AxisData {
+            roll: m.x.0 * x + m.x.1 * y + m.x.2 * z,
+            pitch: m.y.0 * x + m.y.1 * y + m.y.2 * z,
+            yaw: m.z.0 * x + m.z.1 * y + m.z.2 * z,
+        }
+    }
+}
+
+fn is_unreliable(payload: &[u8]) -> bool {
+    protobuf::fields(payload).any(|field| matches!(field, (2, Value::Varint(STATUS_UNRELIABLE))))
+}
+
+fn parse_uid(bytes: &[u8]) -> Option<Uid> {
+    let mut low = None;
+    let mut high = None;
+    for field in protobuf::fields(bytes) {
+        match field {
+            (1, Value::Fixed64(value)) => low = Some(value),
+            (2, Value::Fixed64(value)) => high = Some(value),
+            _ => (),
+        }
+    }
+    Some(Uid {
+        low: low?,
+        high: high?,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn backoff_doubles_to_cap_and_resets() {
+        let now = Instant::now();
+        let mut backoff = Backoff::new(now);
+        assert!(backoff.ready(now));
+        let delays: Vec<u64> = (0..7).map(|_| backoff.fail(now).as_secs()).collect();
+        assert_eq!(delays, vec![3, 6, 12, 24, 48, 60, 60]);
+        assert!(!backoff.ready(now + Duration::from_secs(59)));
+        assert!(backoff.ready(now + RETRY_MAX));
+        backoff.reset();
+        assert_eq!(backoff.fail(now), RETRY_MIN);
+    }
+
+    #[test]
+    fn lookup_retries_with_backoff() {
+        let now = Instant::now();
+        let mut lookup = Lookup::new(now);
+        assert_eq!(lookup.due(now), None);
+        assert_eq!(lookup.due(now + Duration::from_secs(2)), None);
+        let at = now + RETRY_MIN;
+        assert_eq!(lookup.due(at), Some(Duration::from_secs(6)));
+        assert_eq!(lookup.due(at + Duration::from_secs(5)), None);
+        let at = at + Duration::from_secs(6);
+        assert_eq!(lookup.due(at), Some(Duration::from_secs(12)));
+    }
+
+    #[test]
+    fn lookup_reports_first_miss_per_sensor() {
+        let mut lookup = Lookup::new(Instant::now());
+        assert!(lookup.first_miss(Sensor::Accel));
+        assert!(!lookup.first_miss(Sensor::Accel));
+        assert!(lookup.first_miss(Sensor::Gyro));
+        assert!(!lookup.first_miss(Sensor::Gyro));
+    }
+
+    const UID: Uid = Uid { low: 1, high: 2 };
+
+    #[test]
+    fn plan_filtered_before_suid() {
+        assert_eq!(plan(true, true, None, false), Action::None);
+        assert_eq!(plan(true, true, Some(UID), false), Action::None);
+    }
+
+    #[test]
+    fn plan_filtered_while_streaming() {
+        assert_eq!(plan(true, true, Some(UID), true), Action::Disable);
+    }
+
+    #[test]
+    fn plan_unfiltered() {
+        assert_eq!(plan(false, true, Some(UID), false), Action::Enable);
+        assert_eq!(plan(false, true, None, false), Action::Lookup);
+        assert_eq!(plan(false, true, Some(UID), true), Action::None);
+    }
+
+    #[test]
+    fn plan_no_server() {
+        for filtered in [false, true] {
+            for uid in [None, Some(UID)] {
+                for streaming in [false, true] {
+                    assert_eq!(plan(filtered, false, uid, streaming), Action::None);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn plan_both_filtered_never_streams() {
+        for server in [false, true] {
+            for uid in [None, Some(UID)] {
+                assert_eq!(plan(true, server, uid, false), Action::None);
+                assert_ne!(plan(true, server, uid, true), Action::Enable);
+                assert_ne!(plan(true, server, uid, true), Action::Lookup);
+            }
+        }
+    }
+
+    #[test]
+    fn unreliable_status() {
+        let mut sample = Vec::new();
+        protobuf::put_float(&mut sample, 1, 9.81);
+        assert!(!is_unreliable(&sample));
+        let mut reliable = sample.clone();
+        protobuf::put_uint(&mut reliable, 2, 3);
+        assert!(!is_unreliable(&reliable));
+        protobuf::put_uint(&mut sample, 2, STATUS_UNRELIABLE);
+        assert!(is_unreliable(&sample));
+    }
+}
