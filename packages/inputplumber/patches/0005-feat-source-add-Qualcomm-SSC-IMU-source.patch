+const ANCHOR_DEVICES: &str = "fastrpc-*dsp";
+
+#[derive(Debug)]
+pub enum SscDevice {
+    Imu(SourceDriver<SscImu>),
+}
+
+impl SourceDeviceCompatible for SscDevice {
+    fn get_device_ref(&self) -> DeviceInfoRef<'_> {
+        match self {
+            SscDevice::Imu(source_driver) => source_driver.info_ref(),
+        }
+    }
+
+    fn get_id(&self) -> String {
+        match self {
+            SscDevice::Imu(source_driver) => source_driver.get_id(),
+        }
+    }
+
+    fn client(&self) -> super::client::SourceDeviceClient {
+        match self {
+            SscDevice::Imu(source_driver) => source_driver.client(),
+        }
+    }
+
+    async fn run(self) -> Result<(), Box<dyn Error>> {
+        match self {
+            SscDevice::Imu(source_driver) => source_driver.run().await,
+        }
+    }
+
+    fn get_capabilities(&self) -> Result<Vec<Capability>, InputError> {
+        match self {
+            SscDevice::Imu(source_driver) => source_driver.get_capabilities(),
+        }
+    }
+
+    fn get_output_capabilities(&self) -> Result<Vec<OutputCapability>, OutputError> {
+        Ok(vec![])
+    }
+
+    fn get_device_path(&self) -> String {
+        match self {
+            SscDevice::Imu(source_driver) => source_driver.get_device_path(),
+        }
+    }
+}
+
+impl SscDevice {
+    pub fn new(
+        device_info: UdevDevice,
+        composite_device: CompositeDeviceClient,
+        conf: Option<config::SourceDevice>,
+    ) -> Result<Self, Box<dyn Error + Send + Sync>> {
+        let device = SscImu::new(conf.as_ref());
+        let source_device = SourceDriver::new(composite_device, device, device_info.into(), conf);
+        Ok(Self::Imu(source_device))
+    }
+}
+
+pub fn is_anchor_device(sysname: &str) -> bool {
+    glob_match(ANCHOR_DEVICES, sysname)
+}
+
+pub fn get_dbus_path(id: String) -> String {
+    let name = id.replace([':', '-', '.'], "_");
+    format!("{}/{}", BUS_SOURCES_PREFIX, name)
+}
diff --git a/src/input/source/ssc/imu.rs b/src/input/source/ssc/imu.rs
new file mode 100644
index 0000000..036ca19
--- /dev/null
+++ b/src/input/source/ssc/imu.rs
@@ -0,0 +1,73 @@
+use std::{collections::HashSet, fmt::Debug};
+
+use crate::{
+    config,
+    drivers::{iio_imu::info::MountMatrix, ssc::driver::Driver},
+    input::{
+        capability::{Capability, Source},
+        event::native::NativeEvent,
+        source::{iio::accel_gyro_3d, InputError, SourceInputDevice, SourceOutputDevice},
+    },
+};
+
+pub struct SscImu {
+    driver: Driver,
+}
+
+impl SscImu {
+    pub fn new(conf: Option<&config::SourceDevice>) -> Self {
+        let mount_matrix = conf
+            .and_then(|c| c.config.as_ref())
+            .and_then(|c| c.imu.as_ref())
+            .and_then(|c| c.mount_matrix.as_ref())
+            .map(|m| MountMatrix {
+                x: (m.x[0], m.x[1], m.x[2]),
+                y: (m.y[0], m.y[1], m.y[2]),
+                z: (m.z[0], m.z[1], m.z[2]),
+            });
+        let sample_rate = conf
+            .and_then(|c| c.ssc.as_ref())
+            .and_then(|c| c.sample_rate);
+        let driver = Driver::new(mount_matrix, sample_rate);
+        Self { driver }
+    }
+}
+
+impl SourceInputDevice for SscImu {
+    fn poll(&mut self) -> Result<Vec<NativeEvent>, InputError> {
+        let events = self.driver.poll().map_err(|e| e.to_string())?;
+        Ok(accel_gyro_3d::translate_events(events))
+    }
+
+    fn get_capabilities(&self) -> Result<Vec<Capability>, InputError> {
+        Ok(CAPABILITIES.into())
+    }
+
+    fn update_event_filter(&mut self, events: HashSet<Capability>) -> Result<(), InputError> {
+        self.driver.update_filtered_events(events);
+        Ok(())
+    }
+
+    fn suspend(&mut self) -> Result<(), InputError> {
+        self.driver.suspend();
+        Ok(())
+    }
+
+    fn resume(&mut self) -> Result<(), InputError> {
+        self.driver.resume();
+        Ok(())
+    }
+}
+
+impl SourceOutputDevice for SscImu {}
+
+impl Debug for SscImu {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("SscImu").finish()
+    }
+}
+
+pub const CAPABILITIES: &[Capability] = &[
+    Capability::Accelerometer(Source::Center),
+    Capability::Gyroscope(Source::Center),
+];
